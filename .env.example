# Copy to .env and fill in. Every setting in lampbot/config.py can be set as LAMP_<NAME>.
ANTHROPIC_API_KEY=sk-ant-...

# LAMP_MODEL=claude-opus-5        # cloud model used for conversation, perception and planning
# LAMP_EFFORT=low                 # low keeps replies snappy; raise for harder reasoning
# LAMP_OFFLINE=false              # true = never call the cloud (local reflexes only)
# LAMP_CAMERA_INDEX=0
# LAMP_MIC_DEVICE=                # index or name from: python -m sounddevice
# LAMP_SPEAKER_DEVICE=
# LAMP_WHISPER_MODEL=base.en      # tiny.en is faster, small.en more accurate
# LAMP_MUSIC_VOLUME=0.35
# LAMP_SFX_VOLUME=0.6
# LAMP_CAMERA_POS=-0.05,0.30,0.22 # laptop camera position in the lamp base frame (metres, lamp faces -x)
# LAMP_MAX_YAW_RATIO=0.32         # how far the head may turn and still count as "looking"
# LAMP_HUM_AFTER_S=5              # seconds without anyone looking before it hums to itself
# LAMP_WAVE_REVERSALS=3           # side-to-side swings that count as a wave
